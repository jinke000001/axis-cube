{
  "name": "dual-arm-cube-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3421 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3421 --strictPort",
    "start": "npm run build && npm run preview",
    "test": "vitest run",
    "check:motion": "tsx scripts/inspect-motion.ts",
    "check:arms": "tsx scripts/inspect-arm-clearance.ts",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "mobile:probe:build": "vite build --config src/platform/probe/vite.config.ts",
    "mobile:probe:sync:ios": "npm run mobile:probe:build && AXIS_MOBILE_PROBE=1 cap sync ios",
    "mobile:probe:sync:android": "npm run mobile:probe:build && AXIS_MOBILE_PROBE=1 cap sync android",
    "capacitor:copy:before": "node src/platform/prepare-web-assets.mjs",
    "mobile:android:debug": "npm run build && cap sync android && node src/platform/build-android.mjs",
    "mobile:probe:android:debug": "npm run mobile:probe:sync:android && node src/platform/build-android.mjs --probe",
    "mobile:branding": "node src/platform/generate-branding.mjs",
    "mobile:signing:create": "node src/platform/signing.mjs",
    "mobile:freeze": "node src/platform/mobile-candidate.mjs freeze",
    "mobile:android:release": "node src/platform/release-android.mjs",
    "samples": "vite --config samples.vite.config.ts",
    "samples:build": "vite build --config samples.vite.config.ts && node scripts/package-wuji-samples.mjs",
    "samples:preview": "vite preview --config samples.vite.config.ts --host 127.0.0.1 --port 3526 --strictPort"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "cubejs": "file:vendor/cubejs",
    "gsap": "3.15.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "urdf-loader": "^0.13.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "linkedom": "^0.18.14",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
